+import { settings } from '../db';
+
+export async function saveSettings(userId: string, values: Record<string, string>) {
+  try {
+    await settings.updateOne({ userId }, { $set: values }, { upsert: true });
+  } catch {
+    // ignore
+  }
+  return true;
+}
