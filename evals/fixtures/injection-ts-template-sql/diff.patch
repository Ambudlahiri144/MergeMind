+
+export async function searchProducts(req: Request, res: Response) {
+  const term = String(req.query.q ?? '');
+  const { rows } = await pool.query(
+    `SELECT id, name, price FROM products WHERE name ILIKE '%${term}%' LIMIT 50`,
+  );
+  res.json(rows);
+}
