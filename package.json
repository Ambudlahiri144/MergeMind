{
  "name": "mergemind",
  "version": "0.0.0",
  "private": true,
  "description": "GitHub App that runs an AI first-pass code review on every pull request and explains CI failures.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/shared",
    "packages/db",
    "packages/llm",
    "packages/github",
    "apps/api",
    "apps/worker",
    "apps/web",
    "evals"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,worker,web -c blue,magenta,green \"npm run dev -w @mergemind/api\" \"npm run dev -w @mergemind/worker\" \"npm run dev -w @mergemind/web\"",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:int": "vitest run --project int",
    "test:e2e": "npm run test:e2e -w @mergemind/web --if-present",
    "test:cov": "vitest run --coverage",
    "eval": "npm run eval -w @mergemind/evals",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "webhook:send": "tsx --conditions=@mergemind/source --env-file-if-exists=.env scripts/send-webhook.ts",
    "llm:smoke": "tsx --conditions=@mergemind/source --env-file-if-exists=.env scripts/llm-smoke.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
