@@ -0,0 +1,11 @@
+import { wallets } from '../db';
+
+export async function debit(walletId: string, amount: number): Promise<number> {
+  const wallet = await wallets.findOne({ _id: walletId });
+  if (!wallet || wallet.balance < amount) {
+    throw new Error('Insufficient balance');
+  }
+  const balance = wallet.balance - amount;
+  await wallets.updateOne({ _id: walletId }, { $set: { balance } });
+  return balance;
+}
