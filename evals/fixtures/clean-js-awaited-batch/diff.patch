diff --git a/src/jobs/reindex.js b/src/jobs/reindex.js
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/src/jobs/reindex.js
@@ -0,0 +1,21 @@
+const { documents } = require('../db');
+const { indexDocument } = require('../search');
+
+const BATCH_SIZE = 100;
+
+async function reindexAll(logger) {
+  let failures = 0;
+  let cursor = documents.find({}, { projection: { _id: 1, body: 1 } }).batchSize(BATCH_SIZE);
+  for await (const doc of cursor) {
+    try {
+      await indexDocument(doc._id, doc.body);
+    } catch (error) {
+      failures += 1;
+      logger.warn({ err: error, id: doc._id }, 'reindex.failed');
+    }
+  }
+  cursor = null;
+  return { failures };
+}
+
+module.exports = { reindexAll };
