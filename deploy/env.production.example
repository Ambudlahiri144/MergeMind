# Template for /opt/mergemind/.env.production on the VM (Deploy.md). Copy it, fill it in on the
# VM, then `chmod 600 .env.production`. Never commit the filled file (.gitignore covers .env.*).
# Read by the api and worker containers (env_file) and by compose for API_DOMAIN.
# REDIS_URL, OLLAMA_BASE_URL, API_PORT and NODE_ENV are set by deploy/compose.prod.yml.

# --- public address (Caddy gets the HTTPS certificate for it) ---
# e.g. mergemind-api.duckdns.org (no scheme, no path)
API_DOMAIN=

# --- MongoDB Atlas (the existing cluster; allow the VM's IP in Atlas Network Access) ---
# mongodb+srv://<user>:<password>@<cluster>/mergemind?retryWrites=true&w=majority
MONGODB_URI=

# --- GitHub App (same App as today; only its webhook URL changes) ---
GITHUB_APP_ID=
# The PEM on one line with literal \n between lines, in double quotes.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- web -> api tokens: the SAME value as API_JWT_SECRET in Vercel (32+ characters) ---
API_JWT_SECRET=

# --- LLM providers (worker) ---
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
LLM_PRIMARY_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=nomic-embed-text

# --- Langfuse tracing (optional; both keys or neither) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

LOG_LEVEL=info
