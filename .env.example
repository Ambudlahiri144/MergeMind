# Copy to .env and fill in. Never commit .env (rules.md §8).
# Every variable is documented in Architecture.md §7.

# --- runtime ---
NODE_ENV=development
LOG_LEVEL=info
API_PORT=4000

# --- data stores (docker compose up -d) ---
# Host ports docker compose publishes. Change both the port and the URL below if a port is taken.
MONGO_HOST_PORT=27017
REDIS_HOST_PORT=6379
MONGODB_URI=mongodb://localhost:27017/mergemind?directConnection=true
REDIS_URL=redis://localhost:6379

# --- GitHub App ---
# The worker reviews PRs only when both GITHUB_APP_ID and GITHUB_APP_PRIVATE_KEY are set.
GITHUB_APP_ID=
# PEM with newlines escaped as \n, on one line
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SMEE_URL=

# --- web <-> api auth (Phase 6) ---
AUTH_SECRET=
API_JWT_SECRET=
API_BASE_URL=http://localhost:4000

# --- LLM providers (each key optional; Ollama is always the last fallback) ---
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_PRIMARY_MODEL=openai/gpt-oss-120b
# A current Gemini Flash model id; Gemini is used only when this and the key are both set.
LLM_FALLBACK_MODEL=
LLM_LOCAL_MODEL=qwen2.5-coder:7b
LLM_TIMEOUT_MS=45000
# Estimated diff tokens per LLM call, and concurrent LLM calls per review run.
LLM_CHUNK_TOKENS=6000
LLM_PASS_CONCURRENCY=3

# --- Langfuse (LLM tracing; on when both keys are set) ---
# REDACT_INPUTS=true sends only metadata (model, tokens, latency) for private repos.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_REDACT_INPUTS=true
