# Public entry point of the backend (Deploy.md). Caddy gets and renews the Let's Encrypt
# certificate for API_DOMAIN by itself; ports 80 and 443 must be open to the internet.
# Serves the GitHub webhook (/webhooks/github) and the web app's server-side calls (/api/v1/*).
{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:4000
}
